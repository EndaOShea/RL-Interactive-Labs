# ============================================
# RL Interactive Labs - Environment Configuration
# ============================================

# Google Gemini API Key
# ----------------------
# This key enables AI-powered tutoring features in the application.
#
# IMPORTANT: This is optional for deployment!
# - If provided: Users can access AI tutoring immediately using your key
# - If not provided: Users will need to enter their own API key via the UI
# - When quota exhausted: Users are automatically prompted to enter their own key
#
# This allows you to provide a "proof of concept" experience without requiring
# users to have an API key upfront.
#
# How to get an API key:
# 1. Visit: https://aistudio.google.com/app/apikey
# 2. Sign in with your Google account
# 3. Click "Create API Key"
# 4. Copy the key and paste it below
#
# Free tier limits: 15 requests per minute (RPM)
# Rate limiting is automatically applied in the application (12 RPM conservative limit)
#
GEMINI_API_KEY=your_api_key_here

# ============================================
# Deployment Notes
# ============================================
#
# For Docker deployment:
# 1. Copy this file to .env: cp .env.example .env
# 2. (Optional) Add your GEMINI_API_KEY above
# 3. Run: docker compose up -d --build
#
# For local development:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. (Optional) Add your GEMINI_API_KEY above
# 3. Run: npm install && npm run dev
#
# Security:
# - Never commit .env or .env.local to version control
# - API keys are loaded at runtime (not baked into Docker images)
# - Users can always provide their own keys via the UI
# - Keys are NOT exposed in server logs or client bundles
#
